<?xml version="1.0"?>
<!-- #################################################################################### -->
<!-- SPECIFICATIONS WERE PROVIDED BY THIS WEBSITE: https://ouster.com/products/hardware/os0-lidar-sensor -->
<!-- #################################################################################### -->

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="lidar">
    <!-- TECHNICAL PROPERTIES -->
    <xacro:property name="min_angle_horizontal" value="${-M_PI}" />
    <xacro:property name="max_angle_horizontal" value="${M_PI}" />
    <xacro:property name="min_angle_vertical" value="${-M_PI/8.0}" />
    <xacro:property name="max_angle_vertical" value="${M_PI/8.0}" />
    <xacro:property name="vertical_samples" value="32" />
    <xacro:property name="horizontal_samples" value="512" />

    <!-- VISUAL PROPERTIES -->
    <xacro:property name="weight" value="0.5" />
    <xacro:property name="diameter" value="0.087" />
    <xacro:property name="height" value="0.075" />

    <xacro:macro name="add_ouster_lidar" params="name x y z roll pitch yaw topic">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${diameter/2}" length="${height}"/>
                </geometry>
                <material name="gray">
                    <color rgba="0.3 0.3 0.3 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${diameter/2}" length="${height}"/>
                </geometry>
            </collision>
        </link>

        <joint name="${name}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${name}"/>
            <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
        </joint>

        <gazebo reference="${name}">
            <sensor name="${name}" type="gpu_lidar">
                <pose relative_to="${name}">0 0 0 0 0 0</pose>
                <topic>${topic}</topic>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>${horizontal_samples}</samples>
                            <resolution>0.18</resolution>
                            <min_angle>${min_angle_horizontal}</min_angle>
                            <max_angle>${max_angle_horizontal}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>${vertical_samples}</samples>
                            <resolution>0.7</resolution>
                            <min_angle>${min_angle_vertical}</min_angle>
                            <max_angle>${max_angle_vertical}</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.2</min>
                        <max>200.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
                <frame_id>${name}</frame_id>
                <gz_frame_id>${name}</gz_frame_id>
                <ign_frame_id>${name}</ign_frame_id>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>