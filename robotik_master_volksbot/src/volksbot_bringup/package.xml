<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>volksbot_bringup</name>
  <version>1.0.0</version>
  <description>
    Base stack for the Fraunhofer Volksbot: motor driver, URDF, IMU, EKF,
    lidar, slam_toolbox and Nav2, in layers you can switch on and off one at a
    time. Everything a frontier-exploration ("SPLAM") solution needs to sit on
    top of, and none of the exploration itself — that part is the assignment.
  </description>
  <maintainer email="trautwein.maximilian04@gmail.com">trauty</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Hardware layer. Built from src/: see vendor.md for the upstreams. -->
  <exec_depend>volksbot_driver</exec_depend>
  <exec_depend>sick_tim</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>phidgets_spatial</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <!-- Mapping and navigation. -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>

  <!-- rviz:=true -->
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
